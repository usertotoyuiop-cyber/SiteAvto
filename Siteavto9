</style>
<script>
/* NUR MESSAGES. Слой messageService — единственное место, работающее с данными.
   Для Supabase замените его методы: тексты и статусы -> таблица messages (+Realtime),
   фото и голосовые (src) -> Storage, обои (dialog.wp) -> таблица chat_settings. */
(()=>{"use strict";
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const E=s=>String(s==null?"":s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
const K="nm_v1",now=()=>Date.now(),uid=()=>Math.random().toString(36).slice(2,9);
const tm=t=>new Date(t).toLocaleTimeString("ru-RU",{hour:"2-digit",minute:"2-digit"});
const dur=s=>Math.floor(s/60)+":"+String(Math.floor(s%60)).padStart(2,"0");
const say=m=>{const e=$("#toast");if(!e)return;e.textContent=m;e.classList.add("show");clearTimeout(say.t);say.t=setTimeout(()=>e.classList.remove("show"),2400)};
const WP={g1:"linear-gradient(160deg,#1b1d27,#10121a)",g2:"linear-gradient(135deg,#1d2b4a,#3b1f4f)",g3:"linear-gradient(135deg,#0f3b3a,#143a5c)",g4:"linear-gradient(135deg,#4a1d2b,#1f1d4f)",g5:"linear-gradient(160deg,#3a2a12,#1a1208)",s1:"#0d0e13",s2:"#12202b",s3:"#1b1530",s4:"#112417"};
const bg=w=>w&&w.startsWith("data:")?`linear-gradient(rgba(9,9,12,.35),rgba(9,9,12,.35)),url("${w}") center/cover`:(WP[w]||WP.g1);
const ND=window.NotaData,ME=()=>{const u=ND.auth.current();return u&&u.id};
let D=[];const wps=()=>{try{return JSON.parse(localStorage.getItem("nm_wp"))||{}}catch(e){return{}}};
const AV=d=>d.av?`<img class="av" src="${E(d.av)}" alt="">`:`<span class="av">${E((d.name||"?")[0]).toUpperCase()}</span>`;
const fromRow=r=>{const x=r.meta||{},img=r.image_url,v=r.voice_url;return{id:r.id,sid:r.sender_id,me:r.sender_id==ME()?1:0,type:v?"voice":img?"img":"text",text:r.content,imgs:img?[img,...(x.imgs||[])]:undefined,src:v,dur:x.dur,wave:x.wave,reply:x.reply,fwd:x.fwd,pin:x.pin,rx:x.rx,edited:x.edited,t:Date.parse(r.created_at),st:r.read_at?"read":"sent"}};
const toRow=(did,m)=>({id:m.id,conversation_id:did,sender_id:m.sid,content:m.text||"",image_url:m.type=="img"?m.imgs[0]:null,voice_url:m.type=="voice"?m.src:null,created_at:new Date(m.t).toISOString(),meta:{imgs:m.type=="img"?m.imgs.slice(1):undefined,dur:m.dur,wave:m.wave,reply:m.reply,fwd:m.fwd,pin:m.pin,rx:m.rx,edited:m.edited}});
const fail=e=>say("Не удалось сохранить: "+(e&&e.message||"ошибка")),persist=(did,m)=>ND.updateMessage(toRow(did,m)).catch(fail);
const svc={get:id=>D.find(d=>d.id==id),msg:(did,id)=>(svc.get(did)||{msgs:[]}).msgs.find(x=>x.id==id),
 send(did,m){m={id:uid(),me:1,sid:ME(),t:now(),st:"sent",...m};const d=svc.get(did);d.msgs.push(m);d.last=m;ND.sendMessage(toRow(did,m)).catch(fail);return m},
 remove(did,id){const d=svc.get(did);d.msgs=d.msgs.filter(x=>x.id!=id);d.last=d.msgs[d.msgs.length-1]||null;ND.deleteMessage(id).catch(fail)},
 pin(did,id){const m=svc.msg(did,id);m.pin=!m.pin;persist(did,m)},
 react(did,id,e){const m=svc.msg(did,id);m.rx=m.rx||{};if(m.rx[e])delete m.rx[e];else m.rx[e]=1;if(!Object.keys(m.rx).length)delete m.rx;persist(did,m)},
 wall(did,w){const o=wps();o[did]=w;try{localStorage.setItem("nm_wp",JSON.stringify(o))}catch(e){}svc.get(did).wp=w},
 read(did){svc.get(did).unread=0;ND.markRead(did).catch(()=>{})}};
async function reload(){if(!ME()){D=[];cur=null;list();chat();return}
 let cs;try{cs=await ND.getConversations()}catch(e){return}const w=wps();
 D=cs.map(c=>{const o=D.find(x=>x.id==c.id),p=c.peer;return{id:c.id,peer:p.id,name:p.display_name||p.username||"Пользователь",av:p.avatar_url,online:p.online,wp:w[c.id],unread:c.unread_count,last:c.last_message?fromRow(c.last_message):null,msgs:o?o.msgs:[],sig:o&&o.sig}});
 if(cur&&!svc.get(cur))cur=null;const d=cur&&svc.get(cur);
 if(d&&$("#nm").classList.contains("show")){try{const n=(await ND.getMessages(cur)).map(fromRow),sig=n.map(m=>m.id+m.st+(m.pin||"")+(m.edited||"")+Object.keys(m.rx||{})).join();d.msgs=n;if(d.unread){d.unread=0;ND.markRead(cur).catch(()=>{})}if(sig!==d.sig){d.sig=sig;chat(true)}}catch(e){}}else if(!d)chat();
 list()}

let cur=null,replyTo=null,editing=null,pend=[],rec=null,draft=null,G=null;const TY={},AU={};
const prv=m=>m.type=="img"?"📷 Фото"+(m.text?" · "+m.text:""):m.type=="voice"?"🎙 Голосовое · "+dur(m.dur):m.text;
const ticks=s=>s=="read"?'<b style="color:#0b5fff">✓✓</b>':s=="delivered"?"✓✓":"✓";
const stat=d=>TY[d.id]?"печатает…":d.online?"в сети":"был(а) недавно";
const player=m=>`<div class="vp" data-v="${m.id}"><button class="b ic sm pl">▶</button><div class="wv">${m.wave.map(h=>`<i style="height:${h}%"></i>`).join("")}</div><span class="vt">${dur(m.dur)}</span><button class="b sm sp">1×</button></div>`;
const msgH=m=>{const d=svc.get(cur),r=m.reply&&d.msgs.find(x=>x.id==m.reply);
 let b=(m.fwd?'<div class="rp">↪ Пересланное сообщение</div>':"")+(r?`<div class="rp">${E(prv(r))}</div>`:"");
 if(m.type=="img")b+=`<div class="imgs">${m.imgs.map((s,i)=>`<img src="${s}" data-g="${m.id}" data-i="${i}" alt="">`).join("")}</div>`+(m.text?`<div>${E(m.text)}</div>`:"");
 else if(m.type=="voice")b+=player(m);else b+=`<div>${E(m.text)}</div>`;
 return `<div class="m${m.me?" me":""}" data-m="${m.id}">${b}${m.rx?`<div class="rx">${Object.keys(m.rx).map(e=>`<span>${e}</span>`).join("")}</div>`:""}<small>${m.pin?"📌 ":""}${m.edited?"изменено · ":""}${tm(m.t)}${m.me?" "+ticks(m.st):""}</small></div>`};
const rp=id=>{const m=svc.msg(cur,id),el=$(`[data-m="${id}"]`);if(m&&el)el.outerHTML=msgH(m)};
function badge(){const n=D.reduce((s,d)=>s+(d.unread||0),0),b=$("#nmb");if(b){b.textContent=n;b.hidden=!n}}
function list(){const q=$("#nsq").value.trim().toLowerCase(),me=ME(),el=$("#nlst"),ne=$("#nc .ne");
 if(ne)ne.innerHTML=`<div style="font-size:3rem">💬</div><h3>${D.length?"Выберите диалог":"Здесь появятся ваши переписки"}</h3><p class="mu">${D.length?"Откройте чат в списке, чтобы продолжить":me?"Нажмите ✎ и найдите пользователя, чтобы написать первым":"Войдите в профиль, чтобы переписываться"}</p>`;
 if(!D.length){el.innerHTML=`<div class="nem"><div class="nei">💬</div><h3>${me?"Пока нет переписок":"Войдите в профиль"}</h3><p class="mu">${me?"Найдите пользователя по имени, @юзернейму или ID — или нажмите «Написать продавцу» в объявлении.":"Сообщения доступны зарегистрированным пользователям."}</p><button class="b p" data-n="${me?"new":"login"}">${me?"Найти пользователя":"Войти в профиль"}</button></div>`;badge();return}
 el.innerHTML=D.filter(d=>d.name.toLowerCase().includes(q)).map(d=>{const l=d.msgs.length?d.msgs[d.msgs.length-1]:d.last;return `<div class="nd${d.id==cur?" on":""}" data-d="${d.id}">${AV(d)}<div class="mt"><b><span class="dot${d.online?" on":""}"></span>${E(d.name)}</b><p>${l?E(prv(l)):"Нет сообщений"}</p></div><div class="nr">${l?`<small>${tm(l.t)}</small>`:""}${d.unread?`<span class="nu">${d.unread}</span>`:""}</div></div>`}).join("")||'<p class="none">Диалоги не найдены</p>';badge()}
function sfilter(){const q=($("#nmq").value||"").trim().toLowerCase();let f=null;$$("#nb .m").forEach(m=>{const hit=!q||m.textContent.toLowerCase().includes(q);m.classList.toggle("dim",!hit);if(q&&hit&&!f)f=m});if(f)f.scrollIntoView({block:"center",behavior:"smooth"})}
function chat(keep){const d=svc.get(cur),nc=$("#nc");nc.classList.toggle("emp",!d);$("#nm").classList.toggle("chat",!!d);if(!d)return;
 $("#nhd").innerHTML=`<button class="b ic sm bk" data-n="back" aria-label="Назад">←</button>${AV(d)}<div style="flex:1;min-width:0"><b>${E(d.name)}${d.verified?" ✔":""}</b><small class="mu" style="display:block" id="nst">${stat(d)}</small></div><button class="b ic sm" data-n="msearch" aria-label="Поиск по сообщениям"><svg class="i"><use href="#i-search"/></svg></button><button class="b ic sm" data-n="wall" aria-label="Обои">🎨</button>`;
 const nb=$("#nb"),s=nb.scrollTop;nb.style.background=bg(d.wp);
 nb.innerHTML=d.msgs.length?d.msgs.map(msgH).join(""):'<p class="none">Сообщений пока нет — напишите первым</p>';
 nb.scrollTop=keep?s:nb.scrollHeight;
 const p=[...d.msgs].reverse().find(m=>m.pin),pn=$("#npin");pn.hidden=!p;if(p){pn.dataset.id=p.id;pn.innerHTML="📌 "+E(prv(p))}
 sfilter()}
async function open(id){cur=id;replyTo=editing=null;pend=[];$("#ni").value="";bar();pv();tog();chat();list();const d=svc.get(id);try{d.msgs=(await ND.getMessages(id)).map(fromRow)}catch(e){say("Не удалось загрузить сообщения")}if(cur==id){svc.read(id);chat();list()}}
async function openNm(){$("#nm").classList.add("show");document.body.style.overflow="hidden";await reload();if(!cur&&innerWidth>860&&D[0])return open(D[0].id);if(cur)open(cur);else{list();chat()}}
async function start(pid){try{const c=await ND.getOrCreateConversation(pid);closeSheet();await reload();open(c.id)}catch(e){say(e&&e.message=="auth"?"Войдите в профиль":"Не удалось начать переписку")}}
function newSheet(){sheet(`<h4>Новая переписка</h4><input class="in" id="nus" placeholder="Имя, @юзернейм или ID" autocomplete="off"><div id="nur"><p class="mu" style="font-size:.82rem">Введите минимум 2 символа</p></div>`);setTimeout(()=>{const x=$("#nus");x&&x.focus()},60)}
function closeNm(){$("#nm").classList.remove("show");document.body.style.overflow=""}
function bar(){const b=$("#nrb"),id=replyTo||editing,m=id&&cur&&svc.msg(cur,id);b.hidden=!m;if(m)b.innerHTML=`<span>${editing?"✎ Редактирование":"↩ Ответ"}: ${E(prv(m))}</span><button class="b ic sm" data-n="barx" aria-label="Отмена">✕</button>`}
function pv(){const p=$("#npv");p.hidden=!pend.length;p.innerHTML=pend.map((s,i)=>`<div><img src="${s}" alt=""><button data-n="pvdel" data-i="${i}" aria-label="Убрать">✕</button></div>`).join("")}
function tog(){const v=$("#ni").value.trim()||pend.length||editing;$("#nmic").hidden=!!v;$("#nsend").hidden=!v}
const sheet=h=>{const s=$("#nsh");s.innerHTML=`<div class="nsb">${h}</div>`;s.hidden=false},closeSheet=()=>{$("#nsh").hidden=true};
const shrink=(f,s,q=.8)=>new Promise(r=>{const fr=new FileReader();fr.onload=()=>{const im=new Image();im.onload=()=>{const k=Math.min(1,s/Math.max(im.width,im.height)),c=document.createElement("canvas");c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext("2d").drawImage(im,0,0,c.width,c.height);r(c.toDataURL("image/jpeg",q))};im.onerror=()=>r("");im.src=fr.result};fr.onerror=()=>r("");fr.readAsDataURL(f)});
const b2d=b=>new Promise(r=>{const f=new FileReader();f.onload=()=>r(f.result);f.onerror=()=>r("");f.readAsDataURL(b)});
function send(){const inp=$("#ni"),txt=inp.value.trim();if(!cur)return;
 if(editing){const m=svc.msg(cur,editing);if(m&&txt){m.edited=1;m.text=txt;persist(cur,m);rp(m.id)}editing=null;inp.value="";bar();tog();return}
 if(!txt&&!pend.length)return;
 const m=svc.send(cur,pend.length?{type:"img",imgs:pend,text:txt,reply:replyTo}:{type:"text",text:txt,reply:replyTo});
 pend=[];replyTo=null;inp.value="";pv();bar();tog();chat();list()}
/* Голос */
const ui=()=>{$("#nfa").hidden=!!(rec||draft);$("#nfr").hidden=!rec;$("#nfd").hidden=!draft;if(rec)$("#rt").textContent=dur((now()-rec.t0)/1000)};
async function peaks(b){try{const ac=new (window.AudioContext||window.webkitAudioContext)(),buf=await ac.decodeAudioData(await b.arrayBuffer()),d=buf.getChannelData(0),n=36,s=Math.floor(d.length/n),o=[];for(let i=0;i<n;i++){let m=0;for(let j=0;j<s;j+=Math.max(1,s>>6))m=Math.max(m,Math.abs(d[i*s+j]||0));o.push(m)}ac.close();const mx=Math.max(...o,.01);return o.map(v=>Math.max(12,Math.round(v/mx*100)))}catch(e){return Array.from({length:36},()=>20+Math.floor(Math.random()*70))}}
async function rstart(){if(!navigator.mediaDevices||!window.MediaRecorder||!cur)return say("Запись голоса не поддерживается в этом браузере");
 try{const st=await navigator.mediaDevices.getUserMedia({audio:true}),mr=new MediaRecorder(st),ch=[],c=rec={mr,ch,t0:now(),cancel:0};
  mr.ondataavailable=e=>{if(e.data.size)ch.push(e.data)};
  mr.onstop=async()=>{st.getTracks().forEach(t=>t.stop());clearInterval(c.iv);
   if(c.cancel){rec=null;ui();return}
   const blob=new Blob(ch,{type:mr.mimeType||"audio/webm"}),src=await b2d(blob),wave=await peaks(blob);
   draft={src,dur:Math.max(1,Math.round((now()-c.t0)/1000)),wave};rec=null;
   $("#nfd").innerHTML=player({id:"draft",wave:draft.wave,dur:draft.dur})+'<button class="b ic sm" data-n="ddel" aria-label="Удалить">🗑</button><button class="b p ic sm" data-n="dsend" aria-label="Отправить">➤</button>';ui()};
  mr.start();c.iv=setInterval(ui,250);ui()}catch(e){rec=null;say("Нет доступа к микрофону")}}
function dclear(){if(AU.draft){AU.draft.pause();delete AU.draft}draft=null;$("#nfd").innerHTML="";ui()}
function vclick(v,t){const id=v.dataset.v,m=id=="draft"?draft:svc.msg(cur,id);if(!m)return;let a=AU[id];
 if(t.closest(".sp")){const r=[1,1.5,2],x=r[(r.indexOf(+v.dataset.r||1)+1)%3];v.dataset.r=x;t.closest(".sp").textContent=x+"×";if(a)a.playbackRate=x;return}
 if(!t.closest(".pl"))return;
 if(!a){a=AU[id]=new Audio(m.src);
  a.ontimeupdate=()=>{const w=$(`[data-v="${id}"]`);if(!w)return;const L=isFinite(a.duration)&&a.duration?a.duration:m.dur,p=a.currentTime/L;[...w.querySelectorAll(".wv i")].forEach((x,i,l)=>x.classList.toggle("f",i/l.length<p));w.querySelector(".vt").textContent=dur(a.currentTime)};
  a.onplay=()=>{const w=$(`[data-v="${id}"] .pl`);if(w)w.textContent="❚❚"};
  a.onpause=()=>{const w=$(`[data-v="${id}"] .pl`);if(w)w.textContent="▶"};
  a.onended=()=>{const w=$(`[data-v="${id}"]`);if(!w)return;w.querySelectorAll(".wv i").forEach(x=>x.classList.remove("f"));w.querySelector(".vt").textContent=dur(m.dur);a.currentTime=0}}
 Object.values(AU).forEach(x=>{if(x!==a)x.pause()});a.playbackRate=+v.dataset.r||1;a.paused?a.play().catch(()=>say("Не удалось воспроизвести")):a.pause()}
/* Галерея */
const allImgs=()=>svc.get(cur).msgs.flatMap(m=>(m.imgs||[]).map((s,i)=>({mid:m.id,i,s,me:m.me})));
function gal(mid,i){const a=allImgs();G=Math.max(0,a.findIndex(x=>x.mid==mid&&x.i==i));gr()}
function gr(){const a=allImgs(),g=$("#ngal");if(!a.length){G=null;g.hidden=true;return}G=(G+a.length)%a.length;const x=a[G];
 g.innerHTML=`<img src="${x.s}" alt=""><div class="gtop"><span>${G+1} / ${a.length}</span><span style="display:flex;gap:8px">${x.me?'<button class="b ic sm" data-n="gd" aria-label="Удалить">🗑</button>':""}<button class="b ic sm" data-n="gx" aria-label="Закрыть">✕</button></span></div>${a.length>1?'<button class="b ic gl1" data-n="gp">‹</button><button class="b ic gr1" data-n="gn">›</button>':""}`;g.hidden=false}
/* Меню сообщения, обои, пересылка */
function mmenu(id){const m=svc.msg(cur,id);if(!m)return;
 sheet(`<div class="rxr">${["👍","❤️","😂","🔥","😮"].map(e=>`<button class="b ic sm" data-n="rx" data-id="${id}" data-e="${e}">${e}</button>`).join("")}</div>`+
 [["reply","↩ Ответить"],["fwd","↪ Переслать"],...(m.me&&m.type=="text"?[["edit","✎ Изменить"]]:[]),["pin",m.pin?"📌 Открепить":"📌 Закрепить"],["del","🗑 Удалить"]].map(([n,l])=>`<button class="b w100" data-n="${n}" data-id="${id}">${l}</button>`).join(""))}
function wallSheet(){const d=svc.get(cur);sheet(`<h4>Обои этого диалога</h4><div class="wg">${Object.keys(WP).map(k=>`<button class="${d.wp==k?"on":""}" data-n="setw" data-w="${k}" style="background:${WP[k]}" aria-label="Обои"></button>`).join("")}</div><label class="b w100" style="cursor:pointer">📷 Своё фото<input id="nwf" type="file" accept="image/*" hidden></label><button class="b w100" data-n="setw" data-w="g1">Сбросить</button>`)}
function act(n,el){const id=el.dataset.id;
 switch(n){
 case"close":closeNm();break;
 case"back":$("#nm").classList.remove("chat");break;
 case"msearch":{const s=$("#nms");s.hidden=!s.hidden;if(!s.hidden)$("#nmq").focus();else{$("#nmq").value="";sfilter()}break}
 case"wall":wallSheet();break;
 case"setw":svc.wall(cur,el.dataset.w);chat(true);closeSheet();break;
 case"send":send();break;
 case"mic":rstart();break;
 case"rcancel":if(rec){rec.cancel=1;rec.mr.stop()}break;
 case"rstop":if(rec)rec.mr.stop();break;
 case"ddel":dclear();break;
 case"dsend":{if(!draft)break;const m=svc.send(cur,{type:"voice",src:draft.src,dur:draft.dur,wave:draft.wave,reply:replyTo});dclear();replyTo=null;bar();chat();list();break}
 case"reply":replyTo=id;editing=null;bar();closeSheet();$("#ni").focus();break;
 case"edit":{const m=svc.msg(cur,id);editing=id;replyTo=null;$("#ni").value=m.text;bar();tog();closeSheet();$("#ni").focus();break}
 case"barx":if(editing)$("#ni").value="";replyTo=editing=null;bar();tog();break;
 case"pin":svc.pin(cur,id);closeSheet();chat(true);break;
 case"del":svc.remove(cur,id);closeSheet();chat(true);list();break;
 case"rx":svc.react(cur,id,el.dataset.e);closeSheet();rp(id);break;
 case"fwd":sheet(`<h4>Переслать в…</h4>`+D.map(d=>`<button class="b w100" data-n="fwdto" data-id="${id}" data-t="${d.id}">${E(d.name)}</button>`).join(""));break;
 case"fwdto":{const m=svc.msg(cur,id),c={type:m.type,fwd:1};["text","imgs","src","dur","wave"].forEach(k=>{if(m[k]!==undefined)c[k]=m[k]});svc.send(el.dataset.t,c);closeSheet();say("Переслано: "+svc.get(el.dataset.t).name);list();if(el.dataset.t==cur)chat();break}
 case"pvdel":pend.splice(+el.dataset.i,1);pv();tog();break;
 case"gopin":{const x=$(`[data-m="${el.dataset.id}"]`);if(x)x.scrollIntoView({block:"center",behavior:"smooth"});break}
 case"login":closeNm();document.querySelector('[data-a="prof"]').click();break;
 case"new":newSheet();break;
 case"start":start(el.dataset.u);break;
 case"gx":G=null;$("#ngal").hidden=true;break;
 case"gp":G--;gr();break;
 case"gn":G++;gr();break;
 case"gd":{const x=allImgs()[G],m=svc.msg(cur,x.mid);m.imgs.splice(x.i,1);if(!m.imgs.length){if(m.text)m.type="text";else svc.remove(cur,m.id)}persist(cur,m);chat(true);list();gr();say("Фото удалено");break}
 }}
/* Сборка интерфейса */
document.body.insertAdjacentHTML("beforeend",`<div class="nm" id="nm" role="dialog" aria-label="Сообщения">
<aside class="nl"><div class="nlh"><h2>Сообщения</h2><span style="display:flex;gap:6px"><button class="b ic sm" data-n="new" aria-label="Новая переписка">✎</button><button class="b ic sm" data-n="close" aria-label="Закрыть">✕</button></span></div><div style="padding:0 14px 10px"><input class="in" id="nsq" placeholder="Поиск диалогов" style="width:100%" autocomplete="off"></div><div class="lst" id="nlst"></div></aside>
<section class="nc emp" id="nc"><div class="ne"><div style="font-size:3rem">💬</div><h3>Выберите диалог</h3><p class="mu">Откройте чат в списке, чтобы начать переписку</p></div>
<div class="nh" id="nhd"></div><div class="nsr" id="nms" hidden><input class="in" id="nmq" placeholder="Поиск по сообщениям" style="flex:1" autocomplete="off"></div><div class="npn" id="npin" data-n="gopin" hidden></div>
<div class="nb" id="nb"></div><div class="nrb" id="nrb" hidden></div><div class="npv" id="npv" hidden></div>
<div class="nf"><div class="nfr" id="nfa"><label class="b ic sm" style="cursor:pointer" title="Фото">📎<input id="nfile" type="file" accept="image/*" multiple hidden></label><input class="in" id="ni" placeholder="Сообщение" autocomplete="off"><button class="b ic sm" data-n="mic" id="nmic" aria-label="Записать голос">🎙</button><button class="b p ic sm" data-n="send" id="nsend" aria-label="Отправить" hidden>➤</button></div>
<div class="nfr" id="nfr" hidden><span class="rd"></span><b id="rt">0:00</b><span class="mu" style="flex:1">Идёт запись…</span><button class="b sm" data-n="rcancel">Отмена</button><button class="b p sm" data-n="rstop">Стоп</button></div><div class="nfr" id="nfd" hidden></div></div></section>
<div class="nsh" id="nsh" hidden></div><div class="gal" id="ngal" hidden></div></div>`);
const tr=$(".tr"),hb=document.createElement("button");hb.className="b ic dm";hb.style.position="relative";hb.setAttribute("aria-label","Сообщения");hb.innerHTML='<svg class="i"><use href="#i-chat"/></svg><b class="bdg" id="nmb" hidden>0</b>';
tr.insertBefore(hb,tr.querySelector('[data-a="set"]')||tr.firstChild);hb.onclick=openNm;
const pl=document.createElement("a");pl.href="#";pl.textContent="Сообщения";pl.onclick=e=>{e.preventDefault();openNm()};$("#pill").appendChild(pl);
const nm=$("#nm");
nm.addEventListener("click",e=>{const t=e.target;
 if(t.id=="nsh")return closeSheet();
 const n=t.closest("[data-n]");if(n)return act(n.dataset.n,n);
 const im=t.closest("img[data-g]");if(im)return gal(im.dataset.g,+im.dataset.i);
 const v=t.closest("[data-v]");if(v&&t.closest("button"))return vclick(v,t);
 const d=t.closest("[data-d]");if(d)return open(d.dataset.d);
 const m=t.closest("[data-m]");if(m)mmenu(m.dataset.m)});
nm.addEventListener("change",async e=>{if(e.target.id=="nwf"&&e.target.files[0]){const s=await shrink(e.target.files[0],1200,.7);if(s){svc.wall(cur,s);chat(true);closeSheet()}else say("Не удалось загрузить фото")}});
$("#nfile").addEventListener("change",async e=>{for(const f of [...e.target.files].slice(0,10-pend.length)){const s=await shrink(f,1000);if(s)pend.push(s)}e.target.value="";pv();tog()});
$("#ni").addEventListener("input",tog);$("#ni").addEventListener("keydown",e=>{if(e.key=="Enter"){e.preventDefault();send()}});
$("#nsq").addEventListener("input",list);$("#nmq").addEventListener("input",sfilter);
document.addEventListener("keydown",e=>{if(e.key!="Escape"||!nm.classList.contains("show"))return;if(!$("#nsh").hidden)closeSheet();else if(!$("#ngal").hidden){G=null;$("#ngal").hidden=true}else closeNm()});
nm.addEventListener("input",async e=>{if(e.target.id!="nus")return;const q=e.target.value.trim(),r=$("#nur");if(q.replace(/^[@#]/,"").length<2){r.innerHTML='<p class="mu" style="font-size:.82rem">Введите минимум 2 символа</p>';return}
 const a=await ND.searchUsers(q);r.innerHTML=a.length?a.map(p=>`<button class="b w100" style="justify-content:flex-start;gap:10px" data-n="start" data-u="${E(p.id)}">${AV({av:p.avatar_url,name:p.display_name})}<span>${E(p.display_name)} <small class="mu">@${E(p.username)} · ID ${E(p.id)}</small></span></button>`).join(""):'<p class="mu" style="font-size:.82rem">Никого не найдено</p>'});
ND.onChange(reload,"messages");reload();
window.NotaMessages={openWith:async pid=>{await openNm();await start(pid)}};
})();
</script>
</body>
</html>
