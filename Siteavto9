<script>
/* ===== NotaData — единственный слой данных. Интерфейс вызывает только NotaData.* =====
   Сейчас работает локальный провайдер (IndexedDB этого браузера). Для Supabase: NotaData.use(supabaseProvider),
   где провайдер реализует те же методы. Соответствие таблицам:
   profiles(id uuid pk = auth.users.id, username, display_name, avatar_url, created_at)
   listings(id, owner_id→profiles, brand, model, year, mileage, engine_type, engine_volume, transmission, drive_type,
            body_type, condition, city, description, price numeric, image_urls text[], created_at)
   conversations(id, participant_1, participant_2, created_at)
   messages(id, conversation_id, sender_id, content, image_url, voice_url, created_at,
            read_at timestamptz null  -- доп. поле для «непрочитанных»; meta jsonb -- ответы/закрепы/реакции, необязательно)
   createListing(d,files): files -> supabase.storage.from("listings").upload(), URL -> image_urls; insert в listings
   getListings: from("listings").select().order("created_at",{ascending:false});  getListingById: .eq("id",id).single()
   searchUsers: from("profiles").select().or("username.ilike.%q%,display_name.ilike.%q%")
   getConversations / getMessages: select по participant_1|2 = auth.uid() и по conversation_id
   sendMessage: insert в messages (медиа — в Storage "chat"); onChange(cb,"messages"): supabase.channel().on("postgres_changes",...)
   auth.current(): оставьте синхронным — держите кэш пользователя через supabase.auth.onAuthStateChange. */
(()=>{"use strict";
const J=(k,d)=>{try{const v=JSON.parse(localStorage.getItem(k));return v==null?d:v}catch(e){return d}};
const uid=()=>crypto.randomUUID?crypto.randomUUID():"id"+Date.now().toString(36)+Math.random().toString(36).slice(2,9);
const iso=()=>new Date().toISOString(),bump=k=>{try{localStorage.setItem("nota_rev_"+k,Date.now()+":"+Math.random())}catch(e){}};
const IDB=(()=>{let p;const open=()=>p||(p=new Promise((ok,no)=>{try{const r=indexedDB.open("nota",1);r.onupgradeneeded=()=>["listings","conversations","messages"].forEach(s=>r.result.createObjectStore(s,{keyPath:"id"}));r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)}catch(e){no(e)}}));
 const tx=async(s,m,f)=>{const d=await open();return new Promise((ok,no)=>{const t=d.transaction(s,m),q=f(t.objectStore(s));t.oncomplete=()=>ok(q&&q.result);t.onerror=t.onabort=()=>no(t.error||new Error("хранилище недоступно"))})};
 return{all:s=>tx(s,"readonly",o=>o.getAll()),get:(s,id)=>tx(s,"readonly",o=>o.get(id)),put:(s,v)=>tx(s,"readwrite",o=>o.put(v)),del:(s,id)=>tx(s,"readwrite",o=>o.delete(id))}})();
/* Профили берутся из уже существующего входа сайта (nx_users / nx_sess) */
const prof=u=>({id:u.id,username:u.user,display_name:u.nick,avatar_url:u.av||"",created_at:new Date(u.created).toISOString(),online:u.id==J("nx_sess",null)||Date.now()-u.seen<9e4});
const auth={current(){const s=J("nx_sess",null),u=J("nx_users",[]).find(x=>x.id==s);return u?prof(u):null},
 profile(id){const u=J("nx_users",[]).find(x=>x.id==id);return u?prof(u):{id,username:"",display_name:"Пользователь",avatar_url:"",online:false}}};
const need=()=>{const u=auth.current();if(!u)throw new Error("auth");return u};
const shrink=(f,s,q)=>new Promise((ok,no)=>{const r=new FileReader();r.onerror=()=>no(new Error("файл не читается"));r.onload=()=>{const im=new Image();im.onerror=()=>no(new Error("не удалось обработать фото"));
 im.onload=()=>{const k=Math.min(1,s/Math.max(im.width,im.height)),c=document.createElement("canvas");c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext("2d").drawImage(im,0,0,c.width,c.height);ok(c.toDataURL("image/jpeg",q))};im.src=r.result};r.readAsDataURL(f)});
const byT=(a,b)=>a.created_at.localeCompare(b.created_at);
const local={name:"local",
 async createListing(d,files){const me=need(),urls=[];for(const f of files)urls.push(await shrink(f,1400,.8));
  const l={id:uid(),owner_id:me.id,brand:d.brand,model:d.model,year:d.year,mileage:d.mileage,engine_type:d.engine_type,engine_volume:d.engine_volume,transmission:d.transmission,drive_type:d.drive_type,body_type:d.body_type,condition:d.condition,city:d.city,description:d.description,price:d.price,image_urls:urls,created_at:iso()};
  await IDB.put("listings",l);bump("listings");return l},
 async getListings(){return(await IDB.all("listings")).sort((a,b)=>byT(b,a))},
