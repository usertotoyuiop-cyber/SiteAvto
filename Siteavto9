async function hash(p,salt){const d=salt+":"+p;try{const b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(d));return[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("")}catch(e){let h=5381;for(const ch of d)h=((h<<5)+h+ch.charCodeAt(0))>>>0;return"f"+h}}
