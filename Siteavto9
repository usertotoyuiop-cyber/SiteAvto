<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#09090c">
<title>Nota — подбор и доставка авто</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%238fd3ff'/><stop offset='1' stop-color='%23b7a6ff'/></linearGradient></defs><rect width='64' height='64' rx='18' fill='url(%23g)'/><g fill='none' stroke='%230b0c10' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'><path d='M25 46V19l22-5v27'/><circle cx='19' cy='46' r='6'/><circle cx='41' cy='41' r='6'/></g></svg>">
<meta name="theme-color" content="#09090c">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{--c1r:143,211,255;--c2r:183,166,255;--c3r:143,240,210;--bg:#09090c;--g:rgba(255,255,255,.055);--g2:rgba(255,255,255,.09);--bd:rgba(255,255,255,.1);--tx:#f4f5f8;--mu:#9ca3b3;--c1:#8fd3ff;--c2:#b7a6ff;--c3:#8ff0d2;--r:26px}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{background:var(--bg);color:var(--tx);font-family:'Manrope',system-ui,sans-serif;line-height:1.55;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0;z-index:-1;background:radial-gradient(60vw 40vw at 85% -10%,rgba(var(--c1r),.13),transparent),radial-gradient(50vw 40vw at -10% 35%,rgba(var(--c2r),.11),transparent)}
a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit;color:inherit}button{cursor:pointer;border:0;background:none}
:focus-visible{outline:2px solid var(--c1);outline-offset:2px}
.i{width:1.2em;height:1.2em;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.w{width:min(1180px,100% - 32px);margin-inline:auto}
section{padding:56px 0}
h1,h2,h3{font-weight:800;letter-spacing:-.02em;line-height:1.12}
.mu{color:var(--mu)}
.gl{background:var(--g);border:1px solid var(--bd);border-radius:var(--r);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.rv{opacity:0;transform:translateY(26px);transition:opacity .7s,transform .7s cubic-bezier(.2,.7,.2,1)}.rv.in{opacity:1;transform:none}

/* Кнопки: приподнимаются и переливаются спокойным градиентом */
.b{position:relative;isolation:isolate;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 22px;border-radius:999px;background:var(--g2);border:1px solid var(--bd);font-weight:700;font-size:.92rem;transition:transform .25s,box-shadow .3s,color .3s,border-color .3s}
.b::before{content:"";position:absolute;inset:0;z-index:-1;opacity:0;transition:opacity .35s;background:linear-gradient(110deg,var(--c1),var(--c2),var(--c3),var(--c1));background-size:300% 100%;animation:sheen 6s linear infinite}
.b:hover{transform:translateY(-3px);box-shadow:0 12px 30px -8px rgba(var(--c1r),.45),0 0 0 1px rgba(var(--c2r),.4);color:#0b0c10;border-color:transparent}
.b:hover::before,.b.on::before{opacity:.92}.b.on{color:#0b0c10}
.b:active{transform:translateY(-1px) scale(.98)}
.b.p{background:#fff;color:#0b0c10;border-color:#fff}
.b.ic{padding:0;width:44px;height:44px}.b.sm{width:38px;height:38px}.b.w100{width:100%}
@keyframes sheen{to{background-position:-300% 0}}

/* Шапка */
.top{position:fixed;top:12px;left:0;right:0;z-index:30}
.top .w{display:flex;align-items:center;justify-content:space-between;gap:12px}
.logo{font-weight:800;font-size:1.4rem;letter-spacing:-.03em;display:flex;align-items:center;gap:8px}.logo span{background:linear-gradient(110deg,var(--c1),var(--c2));-webkit-background-clip:text;background-clip:text;color:transparent}
.pill{display:flex;gap:4px;padding:6px;border-radius:999px;background:rgba(20,21,27,.7);border:1px solid var(--bd);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.pill a{padding:9px 14px;border-radius:999px;font-size:.84rem;font-weight:600;color:var(--mu);transition:.25s}
.pill a:hover{color:#fff;background:var(--g2)}.pill a.act{color:#fff;background:var(--g2)}
.tr{display:flex;align-items:center;gap:8px}
.bdg{position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;border-radius:9px;background:var(--c1);color:#0b0c10;font-size:.68rem;font-weight:800;display:grid;place-items:center;padding:0 4px}
.bg{display:none}

/* Аватары */
.av{width:38px;height:38px;border-radius:50%;object-fit:cover;background:linear-gradient(135deg,var(--c2),var(--c1));display:grid;place-items:center;font-weight:800;color:#0b0c10;flex:none}
.av.s{width:30px;height:30px;font-size:.8rem}.av.l{width:104px;height:104px;font-size:2.2rem}

/* Первый экран */
.hero{display:grid;grid-template-columns:1.1fr 1fr;gap:16px;padding-top:96px}
.hl{padding:38px 30px;text-align:center;display:flex;flex-direction:column;align-items:center}
.badge{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;background:var(--g2);font-size:.78rem;font-weight:700}
.hl h1{font-size:clamp(2.1rem,4.8vw,3.6rem);margin:22px 0 16px}
.hl p{color:var(--mu);max-width:50ch;margin-bottom:24px}
.hb{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:28px;width:100%}
.stats div{padding:18px 8px;border-radius:20px;background:var(--g);border:1px solid var(--bd);transition:.3s}.stats div:hover{transform:translateY(-4px);border-color:rgba(var(--c1r),.4)}
.stats b{display:block;font-size:1.5rem}.stats span{color:var(--mu);font-size:.76rem;line-height:1.3;display:block}
.hr{position:relative;min-height:440px;overflow:hidden;background:linear-gradient(160deg,#1b1d27,#0f1015) center/cover no-repeat;display:flex;align-items:flex-end}
.hr::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(9,9,12,0) 30%,rgba(9,9,12,.9))}
.hr .cs{position:absolute;top:18%;left:8%;width:84%;opacity:.5}.hr.pic .cs{display:none}
.hcap{position:relative;z-index:2;padding:26px;display:grid;gap:14px;width:100%}.hcap b{display:block}.hcap span{color:var(--mu);font-size:.82rem}

/* Секции */
.sh{text-align:center;margin-bottom:30px}.sh h2{font-size:clamp(1.7rem,3.4vw,2.4rem)}.sh p{color:var(--mu);max-width:56ch;margin:10px auto 0}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.tile{padding:26px;transition:transform .3s,border-color .3s,box-shadow .3s}.tile:hover{transform:translateY(-6px);border-color:rgba(var(--c1r),.4);box-shadow:0 18px 40px -16px rgba(var(--c1r),.3)}
.tile .ib{width:48px;height:48px;border-radius:15px;background:var(--g2);display:grid;place-items:center;font-size:1.35rem;color:var(--c1);margin-bottom:16px}
.tile h3{font-size:1.08rem;margin-bottom:6px}.tile p{color:var(--mu);font-size:.9rem}
.steps{counter-reset:s}.steps .tile::before{counter-increment:s;content:counter(s);display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--c1),var(--c2));color:#0b0c10;font-weight:800;margin-bottom:14px}

/* Каталог */
.tb{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px;align-items:center}
.in{padding:12px 18px;border-radius:999px;background:var(--g);border:1px solid var(--bd);min-width:0;transition:border-color .25s,box-shadow .25s}
.in:focus{outline:0;border-color:var(--c1);box-shadow:0 0 0 3px rgba(var(--c1r),.18)}
select.in option{background:#15161b}.tb .in{flex:1 1 200px}
.rg{display:flex;align-items:center;gap:10px;flex:1 1 240px;color:var(--mu);font-size:.85rem}.rg input{flex:1;accent-color:var(--c1)}.rg b{color:var(--tx);white-space:nowrap}
.chips{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 10px;scrollbar-width:none}.chips::-webkit-scrollbar{display:none}
.chips .b{padding:9px 16px;font-size:.85rem;white-space:nowrap}
.cnt{color:var(--mu);margin:4px 0 16px;font-size:.9rem}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:18px}
.card{overflow:hidden;display:flex;flex-direction:column;transition:transform .35s,border-color .35s,box-shadow .35s;animation:pop .5s both}
@keyframes pop{from{opacity:0;transform:translateY(18px)}}
.card:hover{transform:translateY(-8px);border-color:rgba(var(--c1r),.4);box-shadow:0 24px 50px -20px rgba(var(--c1r),.35)}
.cph{position:relative;aspect-ratio:16/10;background:linear-gradient(160deg,#1c1e28,#101116);overflow:hidden;cursor:pointer;display:flex;align-items:center}
.cph img,.ph.big img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s}.card:hover .cph img{transform:scale(1.07)}
.cph .cs{width:90%;margin:auto}
.chip{position:absolute;top:12px;left:12px;padding:5px 12px;border-radius:999px;background:rgba(9,9,12,.65);backdrop-filter:blur(8px);font-size:.72rem;font-weight:700;border:1px solid var(--bd)}.chip.rs{color:var(--mu)}
.fv{position:absolute;top:10px;right:10px}
.cb{padding:18px;display:flex;flex-direction:column;gap:8px;flex:1}.cb h3{font-size:1.12rem}
.sp{color:var(--mu);font-size:.85rem}.cf{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:6px}
.pr{font-size:1.15rem}.xl{font-size:1.7rem;display:block;margin:8px 0}.ca{display:flex;gap:6px}.ca .b{width:40px;height:40px}
.mo{display:flex;justify-content:center;margin-top:26px}.none{grid-column:1/-1;text-align:center;color:var(--mu);padding:40px}

/* Отзывы, FAQ, контакты */
.stars{color:var(--c3);display:flex;gap:2px;margin-bottom:10px}.stars .i{fill:currentColor;width:1em;height:1em}
.rvw p{color:#d6dae3;margin-bottom:14px}.rvw b{display:block}
details{padding:0;margin-bottom:10px;overflow:hidden}summary{list-style:none;padding:20px 24px;font-weight:700;cursor:pointer;display:flex;justify-content:space-between;gap:12px;transition:color .25s}summary:hover{color:var(--c1)}
summary::-webkit-details-marker{display:none}summary::after{content:"+";font-size:1.5rem;line-height:1;color:var(--c1);transition:transform .3s}details[open] summary::after{transform:rotate(45deg)}
details p{padding:0 24px 20px;color:var(--mu)}
.faq{max-width:780px;margin:auto}
.cont{display:grid;grid-template-columns:1fr 1fr;gap:16px}.cont>div{padding:32px}.cont h2{font-size:1.8rem;margin-bottom:10px}
.fm{display:grid;gap:12px}.fm label{font-size:.8rem;color:var(--mu);display:grid;gap:6px}.fm textarea{min-height:100px;resize:vertical;border-radius:20px}
.li{display:flex;align-items:center;gap:10px;margin-top:14px;color:var(--mu)}.li .i{color:var(--c1)}
footer{padding:32px 0 40px;color:var(--mu);font-size:.85rem;border-top:1px solid var(--bd)}footer .w{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px}

/* Окна */
.md{position:fixed;inset:0;z-index:70;background:rgba(5,6,9,.7);backdrop-filter:blur(6px);display:grid;place-items:center;padding:16px;opacity:0;pointer-events:none;transition:opacity .3s}.md.show{opacity:1;pointer-events:auto}
.mb{position:relative;background:#111218;border:1px solid var(--bd);border-radius:28px;width:min(940px,100%);max-height:92vh;overflow:auto;padding:30px;transform:translateY(28px) scale(.97);transition:transform .35s cubic-bezier(.2,.8,.2,1)}
.md.show .mb{transform:none}.mb.sm{width:min(560px,100%)}
.x{position:absolute;top:14px;right:14px;z-index:3}
.mb h2{margin:0 40px 16px 0;font-size:1.6rem}
.dt{display:grid;grid-template-columns:1.1fr 1fr;gap:26px}
.ph.big{border-radius:20px;overflow:hidden;background:linear-gradient(160deg,#1c1e28,#101116);aspect-ratio:4/3;display:flex;align-items:center;cursor:zoom-in}.ph.big .cs{width:92%;margin:auto}.ph.big.zoom{cursor:zoom-out}.ph.big.zoom img{transform:scale(1.6)}.ph.big img{transition:transform .5s}
.spg{display:grid;grid-template-columns:1fr 1fr;gap:4px 18px;margin:14px 0}.spg div{display:flex;justify-content:space-between;gap:8px;border-bottom:1px solid var(--bd);padding:7px 0;font-size:.88rem}.spg span{color:var(--mu)}
.ab{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.it{display:grid;grid-template-columns:96px 1fr auto;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--bd)}
.it .th{border-radius:14px;overflow:hidden;aspect-ratio:4/3;background:#1a1c25;display:flex;align-items:center}.it .th img{width:100%;height:100%;object-fit:cover}.it .th .cs{width:100%}
.qt{display:flex;align-items:center;gap:8px;margin-top:6px}.qt .b{width:32px;height:32px;padding:0}
.tt{display:flex;justify-content:space-between;font-size:1.3rem;font-weight:800;margin:18px 0 6px}
.sg{display:grid;gap:20px}.sg h4{font-size:.8rem;color:var(--mu);margin-bottom:8px;text-transform:uppercase;letter-spacing:.08em}.chs{display:flex;flex-wrap:wrap;gap:8px}

/* Профиль */
.tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:5px;border-radius:999px;background:var(--g);margin-bottom:18px}.tabs .b{border:0;background:none}
.err{color:#ff8e9b;font-size:.85rem;min-height:1.2em}
.pf{display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin-bottom:18px}
.pf h3{font-size:1.4rem}.idc{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:999px;background:var(--g2);font-weight:700;font-size:.85rem;margin-top:8px}
.ps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}.ps div{padding:16px;border-radius:18px;background:var(--g);border:1px solid var(--bd)}.ps span{display:block;color:var(--mu);font-size:.75rem}.ps b{font-size:.98rem}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#6b7280;margin-right:6px}.dot.on{background:#3ddc97;box-shadow:0 0 10px #3ddc97}
.fr{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:center;padding:14px;margin-top:10px;border-radius:18px;background:var(--g);border:1px solid var(--bd)}.fr small{color:var(--mu);display:block}
.srow{display:flex;gap:8px}.srow .in{flex:1}
.avu{display:flex;align-items:center;gap:14px}.fi{display:none}
.hint{color:var(--mu);font-size:.8rem;margin-top:12px}

.toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,140px);background:#1c1e28;border:1px solid var(--bd);padding:13px 22px;border-radius:999px;z-index:90;transition:transform .4s cubic-bezier(.2,.8,.2,1);box-shadow:0 10px 30px rgba(0,0,0,.4);max-width:92vw}.toast.show{transform:translate(-50%,0)}
.wafab{position:fixed;right:18px;bottom:22px;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,var(--c3),var(--c1));color:#0b0c10;display:grid;place-items:center;font-size:1.5rem;z-index:35;box-shadow:0 10px 30px -6px rgba(var(--c3r),.5);transition:transform .25s}.wafab:hover{transform:translateY(-4px) scale(1.05)}
.bnav{display:none}
.noanim *,.noanim *::before,.noanim *::after{animation:none!important;transition:none!important}.noanim .rv{opacity:1;transform:none}

@media(max-width:1000px){.pill a{padding:9px 10px}}
@media(max-width:860px){
 body{padding-bottom:calc(76px + env(safe-area-inset-bottom))}
 .top{top:calc(8px + env(safe-area-inset-top))}
 .pill{display:none;position:absolute;top:56px;left:0;right:0;flex-direction:column;border-radius:24px;padding:10px;margin:0 16px}.pill.open{display:flex}.pill a{padding:14px}
 .bg{display:grid}.tr .dm{display:none}
 .hero{grid-template-columns:1fr;padding-top:84px}.hr{min-height:320px}.hl{padding:28px 18px}
 .cont,.dt{grid-template-columns:1fr}.ps{grid-template-columns:1fr}.spg{grid-template-columns:1fr}
 .md{place-items:end center;padding:0}.mb{border-radius:26px 26px 0 0;width:100%;max-height:92vh;padding:24px 18px calc(24px + env(safe-area-inset-bottom));transform:translateY(100%)}
 .bnav{position:fixed;left:10px;right:10px;bottom:calc(10px + env(safe-area-inset-bottom));z-index:36;display:grid;grid-template-columns:repeat(5,1fr);padding:6px;border-radius:26px;background:rgba(20,21,27,.88);border:1px solid var(--bd);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
 .bnav a,.bnav button{position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px 2px;min-height:50px;border-radius:20px;font-size:.66rem;color:var(--mu);transition:.25s}
 .bnav .i{font-size:1.35rem}.bnav .on,.bnav a:active,.bnav button:active{color:#fff;background:var(--g2)}
 .bnav .bdg{top:2px;right:calc(50% - 22px)}
 .wafab{bottom:calc(92px + env(safe-area-inset-bottom));right:14px;width:50px;height:50px}
 .toast{bottom:calc(96px + env(safe-area-inset-bottom))}
 .it{grid-template-columns:76px 1fr}.it>b{grid-column:2}
 input,select,textarea{font-size:16px}
 .tb .in{flex:1 1 100%}
}
@media(pointer:coarse){.b.ic{width:46px;height:46px}.b.sm{width:42px;height:42px}}
</style>
<style>
/* ===== Сервисы: калькулятор, кредит, трекер ===== */
.sv-card{padding:28px;max-width:1000px;margin:auto}
.sv-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:5px;border-radius:999px;background:var(--g);margin-bottom:24px}
.sv-tabs .b{border:0;background:none;padding:12px 8px}
.sv-pane{display:none}.sv-pane.on{display:block;animation:pop .4s both}
.sv-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:26px;align-items:start}
.sv-fg{display:grid;gap:18px}
.sv-f{display:grid;gap:8px;font-size:.8rem;color:var(--mu);min-width:0}
.sv-f>span b{color:var(--tx)}.sv-f .in{width:100%;color:var(--tx)}
.sv-f .chs .b{padding:9px 14px;font-size:.85rem}
.sv-rg{width:100%;accent-color:var(--c1);height:28px}
.sv-res{padding:24px;border-radius:22px;background:var(--g);border:1px solid var(--bd);display:grid;gap:12px;position:sticky;top:96px;min-width:0}
.sv-lb{color:var(--mu);font-size:.8rem;display:block}
.sv-big{display:block;font-size:clamp(1.7rem,4vw,2.3rem);font-weight:800;letter-spacing:-.02em;line-height:1.1;background:linear-gradient(110deg,var(--c1),var(--c2));-webkit-background-clip:text;background-clip:text;color:transparent}
.sv-rows{display:grid}
.sv-rw{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid var(--bd);font-size:.88rem}
.sv-rw:last-child{border-bottom:0}.sv-rw span{color:var(--mu)}.sv-rw b{text-align:right}
.sv-act{display:flex;gap:8px;flex-wrap:wrap}
.sv-bar{display:flex;height:10px;border-radius:999px;overflow:hidden;background:var(--g2)}.sv-bar em{display:block;height:100%}
.sv-lg{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.76rem;color:var(--mu)}
.sv-lg em{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px}
.sv-try{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:14px;font-size:.85rem}
.sv-try .b{padding:8px 14px;font-size:.82rem}
.sv-ord{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:18px;border-radius:20px;background:var(--g);border:1px solid var(--bd);margin-top:18px}
.sv-no{font-size:1.5rem;display:block}
.sv-on{text-align:right;color:var(--mu);font-size:.88rem}.sv-on b{color:var(--tx);font-size:1.05rem}
.sv-tm{display:grid;margin-top:22px;max-width:640px}
.sv-s{position:relative;display:grid;grid-template-columns:36px 1fr;gap:14px;padding-bottom:20px}
.sv-s::before{content:"";position:absolute;left:17px;top:36px;bottom:0;width:2px;background:var(--bd)}
.sv-s:last-child{padding-bottom:0}.sv-s:last-child::before{display:none}
.sv-d{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:var(--g2);border:1px solid var(--bd);color:var(--mu);font-weight:800;font-size:.85rem;z-index:1}
.sv-s.done::before{background:linear-gradient(var(--c1),var(--c2))}
