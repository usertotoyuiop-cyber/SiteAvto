const ETT_NEW=[[8500,.54,2.5],[16700,.48,3.5],[42300,.48,5.5],[84500,.48,7.5],[169000,.48,15],[Infinity,.48,20]]; // до N €: % и минимум €/см³
const ETT_35=[[1000,1.5],[1500,1.7],[1800,2.5],[2300,2.7],[3000,3],[Infinity,3.6]];
const ETT_5=[[1000,3],[1500,3.2],[1800,3.5],[2300,4.8],[3000,5],[Infinity,5.7]];
const pick=(tb,v)=>tb.find(r=>v<=r[0]);
