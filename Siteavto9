// Свои фото: GALLERY={1:["https://site.kz/camry-1.jpg","https://site.kz/camry-2.jpg"]}  (ключ = номер авто в каталоге)
const GALLERY={};
const GP=ls.g("nx_gp",{}),GX={id:0,i:0};
const svgFront=c=>`<svg class="cs" viewBox="0 0 320 170"><ellipse cx="160" cy="158" rx="105" ry="7" fill="rgba(0,0,0,.35)"/><path d="M70 120L78 78Q84 56 108 50H212Q236 56 242 78L250 120Z" fill="${c}"/><path d="M92 76Q98 62 114 58H206Q222 62 228 76Z" fill="rgba(255,255,255,.7)"/><rect x="62" y="116" width="196" height="26" rx="8" fill="${c}"/><rect x="62" y="116" width="196" height="26" rx="8" fill="rgba(0,0,0,.22)"/><circle cx="92" cy="128" r="9" fill="#ffe9a6"/><circle cx="228" cy="128" r="9" fill="#ffe9a6"/><rect x="132" y="126" width="56" height="12" rx="3" fill="#0b0c10"/><rect x="66" y="140" width="28" height="22" rx="6" fill="#0b0c10"/><rect x="226" y="140" width="28" height="22" rx="6" fill="#0b0c10"/></svg>`;
const unw=u=>u.startsWith("//")?"https:"+u:u;
const fk=u=>{const p=u.split("?")[0].split("/"),l=p[p.length-1];return /^\d+px-/.test(l)?p[p.length-2]:l};
function slides(c){let r=[];const own=GALLERY[c.id];
 if(own&&own.length)r=own.map(u=>({big:u,small:u}));
 else{if(c.img)r.push({big:c.img,small:c.im0||c.img});(GP[c.w]||[]).forEach(([s,b])=>{if(!r.some(x=>fk(x.small)==fk(s)))r.push({big:b,small:s})})}
 return r.length?r:[{svg:svg(c.c)},{svg:svgFront(c.c)}]}
const gxSig=c=>slides(c).map(s=>s.big||"svg").join("|");
function gxHTML(c){const L=slides(c);GX.i=Math.min(GX.i,L.length-1);
 const sl=s=>s.svg?`<div class="gx-sl">${s.svg}</div>`:`<div class="gx-sl"><img src="${esc(s.big)}" data-fb="${esc(s.small)}" alt="${esc(c.b+" "+c.m)}" draggable="false"></div>`;
 const th=(s,i)=>`<button type="button" class="gx-t${i==GX.i?" on":""}" data-a="gxgo" data-i="${i}" aria-label="${i+1}">${s.svg?s.svg:`<img src="${esc(s.small)}" alt="" loading="lazy" draggable="false">`}</button>`;
 const many=L.length>1;
 return `<div class="gx" data-sig="${esc(gxSig(c))}"><div class="gx-main" data-a="gxbig"><div class="gx-track" style="transform:translateX(-${GX.i*100}%)">${L.map(sl).join("")}</div>${many?`<button type="button" class="b ic sm gx-nav gx-p" data-a="gxp" aria-label="${t("gx_p")}">${I("arr")}</button><button type="button" class="b ic sm gx-nav gx-n" data-a="gxn" aria-label="${t("gx_n")}">${I("arr")}</button><span class="gx-cnt">${GX.i+1} / ${L.length}</span>`:""}</div>${many?`<div class="gx-th">${L.map(th).join("")}</div>`:""}</div>`}
function gxUpdate(c){const g=$(".gx");if(!g||g.dataset.sig==gxSig(c))return;g.outerHTML=gxHTML(c);if(!$("#gxlb").hidden)lbPaint()}
function gxSync(){if(mode&&mode[0]=="car"){const c=byId(mode[1]);if(c)gxUpdate(c)}}
async function gxLoad(c){if(GALLERY[c.id]||GP[c.w])return;
 try{const r=await fetch("https://en.wikipedia.org/api/rest_v1/page/media-list/"+encodeURIComponent(c.w.replace(/ /g,"_")));if(!r.ok)return;
  const j=await r.json(),bad=/logo|icon|emblem|badge|symbol|flag|map|diagram|chart|signature|wikidata|commons-/i;
  GP[c.w]=(j.items||[]).filter(x=>x.type=="image"&&x.showInGallery!==false&&/\.(jpe?g|png|webp)$/i.test(x.title)&&!bad.test(x.title)&&x.srcset&&x.srcset.length).slice(0,8).map(x=>{const s=unw(x.srcset[0].src);return[s,s.replace(/\/\d+px-([^\/]*)$/,"/960px-$1")]});
  ls.s("nx_gp",GP);if(mode&&mode[0]=="car"&&mode[1]==c.id)gxUpdate(c)}catch(e){}}
function gxGo(i){const c=byId(GX.id);if(!c)return;const n=slides(c).length;GX.i=(i+n)%n;const g=$(".gx");
 if(g){g.querySelector(".gx-track").style.transform=`translateX(-${GX.i*100}%)`;g.querySelectorAll(".gx-t").forEach((b,k)=>b.classList.toggle("on",k==GX.i));
  const cn=g.querySelector(".gx-cnt");if(cn)cn.textContent=`${GX.i+1} / ${n}`;
  const th=g.querySelector(".gx-th"),on=g.querySelector(".gx-t.on");if(th&&on)th.scrollTo({left:on.offsetLeft-th.clientWidth/2+on.clientWidth/2,behavior:"smooth"})}
 if(!$("#gxlb").hidden)lbPaint()}
function lbPaint(){const c=byId(GX.id);if(!c)return;const L=slides(c),s=L[GX.i],b=$("#gxlbi");
 b.innerHTML=s.svg?`<div class="gx-lsv">${s.svg}</div>`:`<img src="${esc(s.big)}" data-fb="${esc(s.small)}" alt="" draggable="false">`;
 b.classList.remove("zoom");b.scrollTo(0,0);$("#gxlbc").textContent=`${GX.i+1} / ${L.length}`;$$("#gxlb .gx-nav").forEach(x=>x.hidden=L.length<2)}
document.addEventListener("error",e=>{const im=e.target;if(!im||im.tagName!=="IMG"||!im.closest(".gx,.gx-lb"))return;
 const fb=im.dataset.fb;if(fb&&im.getAttribute("src")!==fb){im.src=fb;return}const c=byId(GX.id);if(c)im.outerHTML=svg(c.c)},true);
let tx=-1,ty=0,tsw=0;const gxEl=e=>e.target.closest&&e.target.closest(".gx-main,#gxlb");
document.addEventListener("touchstart",e=>{if(!gxEl(e))return;tx=e.touches[0].clientX;ty=e.touches[0].clientY},{passive:true});
document.addEventListener("touchend",e=>{if(!gxEl(e)||tx<0)return;const dx=e.changedTouches[0].clientX-tx,dy=e.changedTouches[0].clientY-ty;tx=-1;
 if(!$("#gxlb").hidden&&$("#gxlbi").classList.contains("zoom"))return;
 if(Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy)*1.3){tsw=Date.now();gxGo(GX.i+(dx<0?1:-1))}},{passive:true});
addEventListener("keydown",e=>{const lb=!$("#gxlb").hidden;
 if(lb){if(e.key=="Escape"){e.stopImmediatePropagation();$("#gxlb").hidden=true}else if(e.key=="ArrowRight")gxGo(GX.i+1);else if(e.key=="ArrowLeft")gxGo(GX.i-1);return}
 if(mode&&mode[0]=="car"&&$(".gx")&&!/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)){if(e.key=="ArrowRight")gxGo(GX.i+1);if(e.key=="ArrowLeft")gxGo(GX.i-1)}},true);

