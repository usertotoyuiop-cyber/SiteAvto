function cuCalc(){const q=Q.cu,ev=q.fuel=="ev",pk=q.rub*RATES.KZT,eurKzt=q.eur/RATES.USD*RATES.KZT,age=Math.max(0,2026-q.year),vol=ev?0:q.vol;let duty=0;
 if(ev)duty=q.scheme=="ett"?.15*pk:0;
 else if(q.scheme=="nat"){duty=.15*pk;if(age>7&&vol>1500&&vol<=3000)duty=Math.min(.18*pk,Math.max(.15*pk,.5*vol*eurKzt))}
 else if(age<=3){const r=pick(ETT_NEW,pk/eurKzt);duty=Math.max(r[1]*pk,r[2]*vol*eurKzt)}
 else duty=pick(age<=5?ETT_35:ETT_5,vol)[1]*vol*eurKzt;
 const exc=!ev&&vol>3000?100*vol:0,vat=(pk+duty+exc)*q.vat/100,fee=6*MRP,coef=vol<=1000?1.5:vol<=2000?3.5:vol<=3000?5:11.5,util=50*MRP*coef,reg=(age<=2?.25:age<=3?50:500)*MRP;
 return{pk,duty,exc,vat,fee,util,reg,total:duty+exc+vat+fee+util+reg}}
